theme_override_fonts/font = ExtResource("3_font")
theme_override_font_sizes/font_size = 20
text = "• Move: W, A, S, D or Arrow Keys
• Attack: SPACE or ENTER to swing your sword
• Progression: Slay all monsters in the area to unlock the portal to the next realm!
• Companion Bonds: In Level 1, follow the hero's lead. In Level 2, take the lead yourself! Both heroes share vitality—guard each other carefully!
• Pause & Options: Press ESC anytime during gameplay to adjust sound volume, toggle fullscreen, or restart."
autowrap_mode = 2

