[node name="StoryText" type="Label" parent="Root/AboutDialog/CenterContainer/PanelContainer/MarginContainer/VBoxContainer/ScrollContainer/ContentVBox" unique_id=293302144]
layout_mode = 2
theme_override_colors/font_color = Color(0.18, 0.14, 0.1, 1)
theme_override_fonts/font = ExtResource("3_font")
theme_override_font_sizes/font_size = 20
text = "You awaken in a serene, sun-drenched field blooming with flowers, having fallen asleep peacefully in your bed the previous night.

Before you can fathom where you are or why you are here, monstrous creatures emerge! Just in the nick of time, the heroic champion from your favorite television show—'The Courages'—leaps into reality to protect you.

Trapped together inside a vivid lucid dreamscape, you two must unite, purge the lands of evil forces, and uncover the strength within yourself to find the way back home.

	- Made by Team NotSoLocked!n (Rafi & Anika) for Gamejam+ 2026"
autowrap_mode = 2

